    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "heic2any": "^0.0.4",
    "html2canvas-pro": "^2.4.3",
    "jspdf": "^4.2.1",
